OPENAI_SECRET_KEY=sk-VOTRE_CLE_OPENAI_ICI
VITE_OPENAI_API_KEY=sk-VOTRE_CLE_OPENAI_PUBLIQUE_ICI

# ========================================
# EMAIL SERVICES (Optionnel)
# ========================================
