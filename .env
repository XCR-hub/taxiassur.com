VITE_SENDGRID_API_KEY=SG.VOTRE_CLE_SENDGRID_PUBLIQUE_ICI

# Mailchimp pour newsletter
MAILCHIMP_SECRET_KEY=VOTRE_CLE_MAILCHIMP_ICI

# ========================================
# ANALYTICS (Optionnel)
# ========================================
VITE_GTAG_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXX

# ========================================
# PAIEMENTS (Optionnel)
# ========================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_VOTRE_CLE_STRIPE_ICI
STRIPE_SECRET_KEY=sk_live_VOTRE_CLE_STRIPE_SECRETE_ICI

# ========================================
# SÉCURITÉ
