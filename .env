# Configuration TaxiAssur.com - Remplacez par vos vraies clés API

# ========================================
# SITE CONFIGURATION
# ========================================
VITE_SITE_URL=https://taxiassur.com
VITE_BRAND_NAME=TaxiAssur
VITE_CONTACT_EMAIL=commercial@xcr.fr

# ========================================
# GOOGLE CUSTOM SEARCH ENGINE (Partner Finder)
# ========================================
# Remplacez par vos vraies clés Google CSE
VITE_CSE_API_KEY=VOTRE_CLE_API_GOOGLE_ICI
VITE_CSE_CX=VOTRE_ID_MOTEUR_CSE_ICI

# ========================================
# INTELLIGENCE ARTIFICIELLE (Optionnel)
# ========================================
