{
  "name": "taxiassur-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap-optional.js && vite build && npm run copy:api && node scripts/generate-deploy-info.js && npm run verify:build",
    "copy:api": "node scripts/copy-static-build-files.js",
    "verify:cloudflare": "node scripts/verify-cloudflare-pages.js",
    "build:cloudflare": "npm run build && npm run verify:cloudflare",
    "deploy:cloudflare:preview": "npm run build:cloudflare && npx wrangler pages deploy dist --project-name taxiassur --branch preview",
    "deploy:cloudflare:prod": "npm run build:cloudflare && npx wrangler pages deploy dist --project-name taxiassur --branch main",
    "build:analyze": "vite build --mode analyze",
    "verify:build": "node scripts/verify-build.js",
    "test:deployment": "node scripts/test-deployment.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "deploy": "npm run build && node scripts/deploy-sftp.js",
    "publish": "node scripts/publish.js",
    "publish:site": "node scripts/publish.js",
    "publish:independent": "node scripts/publish.js --skip-bolt --vercel",
    "publish:staging": "node scripts/publish.js --skip-git --skip-supabase --skip-bolt --skip-vercel",
    "publish:with-bolt": "node scripts/publish.js --with-bolt",
    "publish:vercel": "node scripts/publish.js --skip-netlify --skip-supabase --skip-bolt --vercel",
    "publish:vercel:validate": "node scripts/publish.js --skip-git --skip-netlify --skip-supabase --skip-bolt --vercel --vercel-skip-domain",
    "deploy:manual": "npm run build && echo 'Build terminé ! Uploadez le dossier /dist sur votre serveur IONOS'",
    "auto-deploy": "node scripts/auto-deploy.js",
    "setup": "node scripts/setup.js",
    "verify": "node scripts/verify-automations.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "verify:production": "node scripts/verify-production-health.cjs",
    "verify:client-compliance": "node scripts/verify-client-compliance.cjs",
    "verify:seo-leadership": "node scripts/verify-seo-leadership.cjs",
    "populate-cities": "node scripts/populate-city-pages.js",
    "backup:full": "node scripts/backup-system.js full",
    "backup:critical": "node scripts/backup-system.js critical",
    "backup:supabase-rest": "node scripts/backup-supabase-rest.cjs",
    "server:install-postgres-read-api": "powershell -ExecutionPolicy Bypass -File scripts/install-server-postgres-read-api.ps1",
    "server:test-postgres-read-api": "powershell -ExecutionPolicy Bypass -File scripts/test-server-postgres-read-api.ps1",
    "server:install-cloudflare-postgres-tunnel": "powershell -ExecutionPolicy Bypass -File scripts/install-server-cloudflare-postgres-tunnel.ps1",
    "server:verify-postgres-mirror": "powershell -ExecutionPolicy Bypass -File scripts/verify-server-postgres-mirror.ps1",
    "server:deploy-postgres-sync": "powershell -ExecutionPolicy Bypass -File scripts/deploy-server-postgres-sync.ps1",
    "server:install-clamav-document-scan": "powershell -ExecutionPolicy Bypass -File scripts/install-server-clamav-document-scan.ps1",
    "server:scan-documents-clamav": "node scripts/scan-supabase-documents-clamav.cjs",
    "d1:apply-schema": "npx wrangler d1 execute taxiassur-prod --remote --file cloudflare/d1/schema-public-cache.sql",
    "d1:build-public-cache": "node scripts/d1-build-public-cache.cjs --out cloudflare/d1/generated/public-cache.sql",
    "d1:import-public-cache": "npm run d1:build-public-cache && npx wrangler d1 execute taxiassur-prod --remote --file cloudflare/d1/generated/public-cache.sql",
    "recovery:list": "node scripts/disaster-recovery.js list",
    "recovery:verify": "node scripts/disaster-recovery.js verify",
    "recovery:restore": "node scripts/disaster-recovery.js restore",
    "ionos:configure": "bash scripts/configure-ionos-complete.sh",
    "ionos:test": "node scripts/test-ionos-complete.js",
    "update:ionos-secrets": "bash scripts/update-ionos-secrets.sh",
    "test:ionos": "node scripts/test-ionos-connection.js",
    "seo:sitemap": "node scripts/generate-clean-sitemap.js",
    "seo:indexnow": "node scripts/submit-indexnow.js",
    "seo:full": "npm run seo:sitemap && npm run seo:indexnow",
    "security:scan-secrets": "node scripts/scan-secrets.cjs",
    "secrets:configure": "bash scripts/configure-supabase-secrets.sh",
    "secrets:list": "supabase secrets list",
    "configure:bolt-webhook": "bash scripts/configure-bolt-webhook.sh",
    "d1:export-public-cache": "node scripts/d1-export-public-cache.cjs",
    "d1:refresh-public-cache": "npm run d1:export-public-cache -- --out cloudflare/d1/generated/supabase-public-cache && node scripts/d1-build-public-cache.cjs --backup cloudflare/d1/generated/supabase-public-cache --out cloudflare/d1/generated/public-cache.sql && npx wrangler d1 execute taxiassur-prod --remote --file cloudflare/d1/schema-public-cache.sql && npx wrangler d1 execute taxiassur-prod --remote --file cloudflare/d1/generated/public-cache.sql",
    "cloudflare:ai-robots": "node scripts/configure-cloudflare-ai-robots.cjs",
    "cloudflare:ai-robots:fix": "powershell -ExecutionPolicy Bypass -File scripts/apply-cloudflare-ai-robots-fix.ps1",
    "seo:quality-audit": "node scripts/seo-quality-audit.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@twilio/voice-sdk": "^2.18.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "glob": "^13.0.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "nodemailer": "^6.9.7",
    "playwright": "^1.57.0",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^5.14.0",
    "ssh2": "^1.15.0",
    "storybook": "^8.6.0",
    "supabase": "^2.76.15",
    "tailwindcss": "^3.4.1",
    "terser": "^5.36.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
