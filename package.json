{
  "name": "taxiassur-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy:api",
    "copy:api": "mkdir -p dist/api dist/content dist/feeds dist/webhooks && cp -r public/api/. dist/api/ 2>/dev/null || true && cp -r public/content/. dist/content/ 2>/dev/null || true && cp -r public/feeds/. dist/feeds/ 2>/dev/null || true && cp -r public/webhooks/. dist/webhooks/ 2>/dev/null || true && cp public/.htaccess dist/.htaccess 2>/dev/null || true",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "deploy": "npm run build && node scripts/deploy.js && echo 'Build terminé ! Uploadez le dossier /dist sur votre serveur IONOS'",
    "auto-deploy": "node scripts/auto-deploy.js",
    "setup": "node scripts/setup.js",
    "verify": "node scripts/verify-automations.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "populate-cities": "node scripts/populate-city-pages.js",
    "backup:full": "node scripts/backup-system.js full",
    "backup:critical": "node scripts/backup-system.js critical",
    "recovery:list": "node scripts/disaster-recovery.js list",
    "recovery:verify": "node scripts/disaster-recovery.js verify",
    "recovery:restore": "node scripts/disaster-recovery.js restore",
    "update:ionos-secrets": "bash scripts/update-ionos-secrets.sh",
    "test:ionos": "node scripts/test-ionos-connection.js",
    "seo:sitemap": "node scripts/generate-clean-sitemap.js",
    "seo:indexnow": "node scripts/submit-indexnow.js",
    "seo:full": "npm run seo:sitemap && npm run seo:indexnow",
    "secrets:configure": "bash scripts/configure-supabase-secrets.sh",
    "secrets:list": "supabase secrets list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "glob": "^13.0.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.1",
    "terser": "^5.36.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
