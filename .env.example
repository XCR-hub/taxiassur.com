# TaxiAssur environment template
#
# Keep this file as placeholders only. Never commit real service keys,
# passwords, private tokens, or API secrets.

# Browser-safe public runtime values
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=SUPABASE_ANON_PUBLIC_KEY
VITE_SITE_URL=https://taxiassur.com
VITE_BRAND_NAME=TaxiAssur
VITE_GTAG_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
VITE_GOOGLE_CSE_API_KEY=RESTRICTED_BROWSER_KEY
VITE_GOOGLE_CSE_CX=CUSTOM_SEARCH_ENGINE_ID
VITE_CONTACT_EMAIL=team@taxiassur.com
VITE_NOINDEX=false

# Public CAPTCHA provider
VITE_CAPTCHA_PROVIDER=turnstile
VITE_TURNSTILE_SITE_KEY=0xPUBLIC_TURNSTILE_SITEKEY
VITE_CAPTCHA_SITE_KEY=0xPUBLIC_TURNSTILE_SITEKEY

# Server-only secrets. Configure these in the hosting provider or Supabase
# function secrets, never in frontend runtime files.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
TURNSTILE_SECRET_KEY=SERVER_ONLY
TURNSTILE_ALLOWED_HOSTNAMES=taxiassur.com,www.taxiassur.com
RESEND_API_KEY=SERVER_ONLY
BREVO_API_KEY=SERVER_ONLY
MONETICO_MAC_KEY=SERVER_ONLY
GOOGLE_SERVICE_ACCOUNT_KEY=SERVER_ONLY
